  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node tools/preview.mjs",
    "test": "npm run check",
    "test:unit": "node tools/run-unit.mjs",
    "test:ssr": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test:dataset:no3": "node tests/no3-dataset-audit.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
